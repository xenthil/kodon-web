@page "/forgot-password"

<PageTitle>Forgot password — Kodon</PageTitle>
<PageHeader />

<section class="auth-page section-wrap">
    <div class="auth-card">
        <a class="brand auth-brand" href="/" aria-label="Kodon home"><img src="ko-logo.png" alt="Kodon" /></a>
        <div class="eyebrow">ACCOUNT RECOVERY</div>
        <h1>Get back to your <em>workspace.</em></h1>
        @if (!submitted)
        {
            <p>Enter the email address you use for Kodon and we'll send instructions to reset your password.</p>
            <EditForm Model="@model" OnValidSubmit="@HandleValidSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <label>
                    Work email
                    <InputText @bind-Value="model.Email" type="email" placeholder="you@company.com" autocomplete="email" />
                    <ValidationMessage For="@(() => model.Email)" />
                </label>
                <button class="button button-dark full-button" type="submit">Send reset link ↗</button>
            </EditForm>
        }
        else
        {
            <p class="form-success" role="status">If an account exists for <strong>@model.Email</strong>, reset instructions will be sent shortly.</p>
            <p>For your security, we don't reveal whether an email is registered. Check your inbox and follow the link to choose a new password.</p>
            <a class="button button-dark full-button" href="/login">Return to sign in</a>
        }
        <div class="auth-note">Remembered your password? <a href="/login">Sign in</a></div>
        <div class="auth-note">Need an account? <a href="/register">Create one</a></div>
    </div>
</section>

@code {
    private readonly ForgotPasswordModel model = new();
    private bool submitted;

    private void HandleValidSubmit() => submitted = true;

    private sealed class ForgotPasswordModel
    {
        [Required(ErrorMessage = "Email address is required.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = string.Empty;
    }
}
